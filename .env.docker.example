# These Vite variables are embedded into the static JavaScript during `docker compose build`.
# The anon key is safe for browser delivery; never use a Supabase service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key
VITE_PUBLIC_APP_ORIGIN=https://nomo.example.com

# Optional local port used by docker-compose.yml.
NOMO_HTTP_PORT=8080

# Packing Worker secrets. Keep the real .env outside source control and load
# these values from the deployment secret manager in production.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-private-bucket
R2_ACCESS_KEY_ID=your-worker-r2-access-key
R2_SECRET_ACCESS_KEY=your-worker-r2-secret-key
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus-2025-12-19
PACKING_WORKER_POLL_MS=3000
PACKING_WORKER_BATCH_SIZE=2
