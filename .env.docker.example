# These Vite variables are embedded into the static JavaScript during `docker compose build`.
# The anon key is safe for browser delivery; never use a Supabase service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-production-anon-key
VITE_PUBLIC_APP_ORIGIN=https://nomo.example.com

# Optional local port used by docker-compose.yml.
NOMO_HTTP_PORT=8080
