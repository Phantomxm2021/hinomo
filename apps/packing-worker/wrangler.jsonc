{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nomo-packing-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 300000
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "PACKING_MEDIA",
      "bucket_name": "nomo-production",
      "preview_bucket_name": "nomo-dev"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "QWEN_OPENAI_BASE_URL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "QWEN_VL_MODEL": "qwen3-vl-plus-2025-12-19",
    "PACKING_WORKER_BATCH_SIZE": "1"
  },
  "observability": {
    "enabled": true
  }
}
