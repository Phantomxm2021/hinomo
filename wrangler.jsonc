{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hinomo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/geo"]
  }
}
